# Base URL for backend API requests.
# In dev, leave this empty to use the Vite proxy (/api -> http://localhost:8001).
VITE_API_BASE_URL="/api"

# Links on the offline front door (shown when no backend answers). Set them in the
# Vercel project, not here; none is a secret. All are optional.
# VITE_DEMO_VIDEO_URL=
# VITE_REPO_URL=https://github.com/Shakti8125/creditAudit
# VITE_CONTACT_URL=mailto:you@example.com
