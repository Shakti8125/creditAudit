# ModelAudit AI: the one environment file for the local demo (D12).
#
# Copy this file to backend/.env and fill in the keys. backend/.env is git-ignored:
# never commit it, and never paste its contents anywhere.
#
# Two things read it:
#   - docker-compose.yml (the supported way to run the backend), and
#   - a backend started on the host from backend/ (uvicorn reads backend/.env).
# Names are case-insensitive (field `database_url` <- env `DATABASE_URL`).
# Keep comments on their own lines: docker compose and python-dotenv parse
# inline comments differently.

# --- Database ---
# Postgres as seen from the host (the compose `db` service publishes 5432 on localhost).
# Compose overrides the host name to `db` inside its own network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/modelaudit

# --- LLM providers ---
# NVIDIA NIM is the primary provider. Gemini is the backup and runs on the free tier (D11),
# so use only synthetic or public documents: free-tier prompts may be used for training.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=

# --- Provider models and routing (PR-01) ---
# Every model ID the app calls is a setting. The values below are the built-in defaults, from
# public docs and not yet confirmed by a live probe, so they are commented out: uncomment and
# change one only when `scripts/demo.sh preflight` says a model is gone. Preflight names the
# candidate that works and the variable to set.
#
# Reranker. If it is gone the app keeps working: retrieval uses its fused order.
# NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# Full rerank endpoint; empty derives it from the model ID.
# NVIDIA_RERANK_URL=
# Comma-separated reranker IDs the probe checks next to the configured one.
# NVIDIA_RERANK_CANDIDATES=nvidia/llama-nemotron-rerank-1b-v2,nvidia/llama-3.2-nv-rerankqa-1b-v2
# Gemini backup (free tier). Failover only; it never serves embeddings.
# GEMINI_GENERATION_MODEL=gemini-3.6-flash
# GEMINI_GENERATION_CANDIDATES=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
# Optional Gemini thinking level for plain chat calls (for example low). Empty sends nothing.
# GEMINI_THINKING_LEVEL=
# NVIDIA chat models: the primary, then the one tried when the primary returns 404.
# NVIDIA_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_FALLBACK_GENERATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Embeddings are pinned: one model, one size, never a failover. Changing either means a
# new Pinecone index (or namespace) and re-embedding every document.
# NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Size of your Pinecone index. Longer vectors are sliced to it; shorter ones are rejected.
# EMBEDDING_DIMENSIONS=1024
# Also send `dimensions` in the embeddings request. Turn on only if the probe shows it is accepted.
# EMBEDDING_SEND_DIMENSIONS=false
# Promote Gemini to primary when it is faster. Off: NVIDIA first, Gemini only when it fails.
# LLM_LATENCY_ROUTING=false
# Score passages with Gemini when the NVIDIA reranker is down (20 slow calls per query).
# RERANK_LLM_FALLBACK=false
# Circuit breakers, per provider and method. Rerank opens sooner and stays open longer.
# LLM_BREAKER_FAILURES=5
# LLM_BREAKER_RESET_SECONDS=30
# RERANK_BREAKER_FAILURES=3
# RERANK_BREAKER_RESET_SECONDS=300
# Check the configured models once at start-up with a few tiny calls, in the background.
# It only logs, never delays start-up, and uses a little free-tier quota.
# LLM_STARTUP_PROBE=false
# LLM_STARTUP_PROBE_TIMEOUT_SECONDS=5

# --- Structured output: gap analysis, compare, judge (PR-02) ---
# Defaults are from NVIDIA's docs, not confirmed by a live probe. `scripts/demo.sh preflight`
# says whether the configured request returns valid JSON and, if not, which value to set.
# How the NVIDIA request asks for schema-constrained JSON: nvext_guided_json,
# top_guided_json or response_format_json_schema.
# NVIDIA_STRUCTURED_MODE=nvext_guided_json
# Send enable_thinking=false on structured calls, so reasoning does not use the output budget.
# NVIDIA_STRUCTURED_DISABLE_THINKING=true
# Output-token budget of a structured call; a reply cut off at it is retried once with double.
# STRUCTURED_MAX_TOKENS=4096
# Largest budget that retry may use.
# STRUCTURED_MAX_TOKENS_CAP=8192
# Gemini backup: auto tries responseJsonSchema, then responseSchema; or pin response_json_schema / response_schema.
# GEMINI_STRUCTURED_SCHEMA_MODE=auto
# Optional Gemini thinking level for structured calls (for example low). Empty sends nothing.
# GEMINI_STRUCTURED_THINKING_LEVEL=

# --- Vector database (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- Auth (RS256) ---
# Leave both keys empty for the local demo: the backend then generates an ephemeral key pair
# at start-up. Tokens stop working after a restart, so sign in again.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting ---
# Off for the local demo. Turning it on needs an Upstash Redis REST URL and token
# (the https://...upstash.io URL, not a redis:// URL).
RATE_LIMIT_ENABLED=false
REDIS_URL=
REDIS_TOKEN=

# --- RAG telemetry ---
# Kill switch for per-request RAG traces (/rag/*). When false, trace ids are still
# returned but not persisted, so feedback on them returns 404.
RAG_TELEMETRY_ENABLED=true

# --- Start-up ---
# Load Docling and spaCy/Presidio before serving, so the first upload is fast (QA-026).
# /health answers only after they are loaded, which takes a few seconds to about a minute.
WARM_MODELS_ON_STARTUP=true
