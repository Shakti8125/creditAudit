# ModelAudit AI backend — environment configuration (example)
# Copy this file to `.env` and fill in real values. Environment variable names
# are resolved case-insensitively by pydantic-settings (field `database_url` <- env `DATABASE_URL`).
# Never commit a real `.env` (it is git-ignored).

# --- Database ---
# SQLite for local dev:
DATABASE_URL=sqlite+aiosqlite:///./test.db
# (PostgreSQL example:)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/modelaudit

# --- Redis / Upstash (rate limiting) ---
REDIS_URL=
REDIS_TOKEN=

# --- LLM providers ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_API_KEY=

# --- Vector database (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- JWT / Auth (RS256) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=RS256

# --- CORS & rate limiting ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_ENABLED=true